PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/bookstore
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE=7d
CLIENT_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the app (e.g. 1 on Render/Railway). Needed so rate limiting sees real client IPs.
TRUST_PROXY=
# Only for `npm test`: a throwaway database (name must contain "test"; it is dropped on every run)
TEST_MONGO_URI=mongodb://127.0.0.1:27017/bookstore_test
